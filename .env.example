# Conexão com o banco MySQL
DATABASE_URL="mysql://user:password@localhost:3306/agendamento_db"

# Porta do servidor da API
PORT=3000

# Segredo usado para assinar os tokens JWT (troque por uma string longa e aleatória)
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Tempo de expiração do token JWT
JWT_EXPIRES_IN="1d"

# Origem permitida pelo CORS (URL do frontend)
CORS_ORIGIN="http://localhost:5173"
